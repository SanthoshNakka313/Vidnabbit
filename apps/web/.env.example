# Copy to .env.local. All values are public (inlined into the browser bundle).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cloudflare's always-passes test key; use the real site key in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# 1 = use in-browser fixtures instead of the API (see src/lib/mock-api.ts).
NEXT_PUBLIC_API_MOCK=0
