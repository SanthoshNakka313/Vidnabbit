    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/webp": "1.5.0",
    "docx": "9.10.0",
    "docx-preview": "0.4.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "html2canvas": "1.4.1",
    "imagetracerjs": "1.2.6",
    "libheif-js": "1.23.5",
    "libraw-wasm": "1.6.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "upng-js": "2.1.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
