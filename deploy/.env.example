# Copy to deploy/.env on the server (chmod 600). Never commit .env.
# Generate the random values with:  ./gen-secrets.sh >> .env

SITE_DOMAIN=vidnabbit.com
API_DOMAIN=api.vidnabbit.com
ACME_EMAIL=you@example.com

# Cloudflare R2 (bucket vidnabbit-downloads, token vidnabbit-api-r2)
R2_ACCOUNT_ID=
R2_BUCKET=vidnabbit-downloads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Turnstile widget for SITE_DOMAIN (secret key; the site key goes in the web app)
TURNSTILE_SECRET=

# Random, from gen-secrets.sh
POSTGRES_PASSWORD=
SIGNING_SECRET=
IP_HASH_KEY_SEED=

WORKER_CONCURRENCY=4
