# Copy to .env for local overrides. Every setting has a safe local default, so this
# file is optional in development. Names map to fields in app/config.py.

APP_ENV=development            # development | test | production (production refuses unsafe config)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=.data                 # downloads, work dirs, blocklist.json, takedowns.jsonl

# Secrets: generated per process if unset (development only). Required in production.
# SIGNING_SECRET=
# IP_HASH_KEY_SEED=

# Turnstile: Cloudflare's always-pass test secret; accepts only XXXX.DUMMY.TOKEN.XXXX.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# TURNSTILE_EXPECTED_HOSTNAME=vidnabbit.example   # required in production

# Egress proxy (Smokescreen). Required in production; optional locally.
# EGRESS_PROXY_URL=http://smokescreen:4750
# EXTRA_DENIED_NETWORKS=            # our own public IPs, comma-separated CIDRs

# Job queue: inline runs downloads inside the API process (one process only).
# redis needs a Redis server and `arq app.worker.WorkerSettings` workers (required in production).
QUEUE_BACKEND=inline
# REDIS_URL=redis://localhost:6379/0

# Takedowns + blocklist in Postgres (required in production). Unset = JSON files in DATA_DIR.
# Migrations run automatically at startup. Operator CLI: python -m app.admin --help
# DATABASE_URL=postgresql://vidnabbit:...@localhost:5432/vidnabbit
# How long takedown requests (names, emails) are kept: 3 years, owner-confirmed 2026-10-25.
# TAKEDOWN_RETENTION_DAYS=1095

STORAGE_BACKEND=local          # local | r2 (production uses r2)
# R2_ACCOUNT_ID=                # Cloudflare account ID (endpoint <id>.r2.cloudflarestorage.com)
# R2_ACCESS_KEY_ID=             # R2 API token scoped to the one bucket, Object Read & Write
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vidnabbit-downloads # private bucket; lifecycle rule: delete dl/ after 1 day
# R2_ENDPOINT_URL=              # optional override for an S3-compatible dev server
FILE_TTL_SECONDS=3600          # capped at 3600 (Safeguard 5)

# Kill switches
EXTRACTION_ENABLED=true
# DISABLED_EXTRACTORS=youtube,instagram
# DISABLED_DOMAINS=example.com
